<?xml version="1.0"?>
<!-- Hospital delivery addon links for TurtleBot3 Waffle.
     NOT a complete robot — these are appended to the TB3 URDF at launch time.
     Parent links (base_link) must already exist. -->

<!-- Materials -->
<material name="tray_grey">
  <color rgba="0.5 0.5 0.55 1.0"/>
</material>
<material name="gripper_dark">
  <color rgba="0.25 0.25 0.30 1.0"/>
</material>
<material name="finger_metal">
  <color rgba="0.35 0.35 0.40 1.0"/>
</material>

<!-- ── Payload Tray ────────────────────────────────────────────────────
     Rigid tray mounted above base_link center.
     Height: ~0.28m above base_link (clears LiDAR at 0.122m)
     Size:   0.30 x 0.26 x 0.02
     ─────────────────────────────────────────────────────────────────── -->
<joint name="tray_joint" type="fixed">
  <parent link="base_link"/>
  <child link="payload_tray_link"/>
  <origin xyz="0 0 0.28" rpy="0 0 0"/>
</joint>

<link name="payload_tray_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.30 0.26 0.02"/>
    </geometry>
    <material name="tray_grey"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.30 0.26 0.02"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.3"/>
    <inertia ixx="0.002" ixy="0.0" ixz="0.0"
             iyy="0.002" iyz="0.0"
             izz="0.004"/>
  </inertial>
</link>

<!-- ── Gripper Base (mount block at front of tray) ───────────────────── -->
<joint name="gripper_base_joint" type="fixed">
  <parent link="payload_tray_link"/>
  <child link="gripper_base_link"/>
  <origin xyz="0.13 0 0.025" rpy="0 0 0"/>
</joint>

<link name="gripper_base_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.04 0.06 0.03"/>
    </geometry>
    <material name="gripper_dark"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.04 0.06 0.03"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
             iyy="0.0001" iyz="0.0"
             izz="0.0001"/>
  </inertial>
</link>

<!-- ── Left Finger ───────────────────────────────────────────────────── -->
<joint name="left_finger_joint" type="fixed">
  <parent link="gripper_base_link"/>
  <child link="left_finger_link"/>
  <origin xyz="0 -0.09 -0.07" rpy="0 0 0"/>
</joint>

<link name="left_finger_link">
  <visual>
    <geometry>
      <box size="0.015 0.015 0.12"/>
    </geometry>
    <material name="finger_metal"/>
  </visual>
  <collision>
    <geometry>
      <box size="0.015 0.015 0.12"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.02"/>
    <inertia ixx="0.00003" ixy="0.0" ixz="0.0"
             iyy="0.00003" iyz="0.0"
             izz="0.00001"/>
  </inertial>
</link>

<!-- ── Right Finger ──────────────────────────────────────────────────── -->
<joint name="right_finger_joint" type="fixed">
  <parent link="gripper_base_link"/>
  <child link="right_finger_link"/>
  <origin xyz="0 0.09 -0.07" rpy="0 0 0"/>
</joint>

<link name="right_finger_link">
  <visual>
    <geometry>
      <box size="0.015 0.015 0.12"/>
    </geometry>
    <material name="finger_metal"/>
  </visual>
  <collision>
    <geometry>
      <box size="0.015 0.015 0.12"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.02"/>
    <inertia ixx="0.00003" ixy="0.0" ixz="0.0"
             iyy="0.00003" iyz="0.0"
             izz="0.00001"/>
  </inertial>
</link>
