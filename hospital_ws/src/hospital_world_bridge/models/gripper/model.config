<?xml version="1.0"?>
<model>
  <name>Robot Gripper Hand</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Two-finger parallel-jaw gripper for hospital delivery robot.
    Holds a 0.15x0.10x0.08m payload between the fingers.
    Mounts on the payload tray at the front of a TurtleBot3 Waffle.
  </description>
</model>
