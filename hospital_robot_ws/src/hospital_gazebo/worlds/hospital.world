          <geometry><box><size>7.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== NURSE STATIONS ================== -->
    <model name="nurse_station_1">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 1.0</size></box></geometry>
          <material><ambient>0.6 0.8 1.0 1</ambient><diffuse>0.6 0.8 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="nurse_station_2">
      <static>true</static>
      <pose>15 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 1.0</size></box></geometry>
          <material><ambient>0.6 0.8 1.0 1</ambient><diffuse>0.6 0.8 1.0 1</diffuse></material>
        </visual>
      </link>
