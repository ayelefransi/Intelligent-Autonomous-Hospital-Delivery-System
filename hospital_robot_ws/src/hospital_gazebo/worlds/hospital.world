    </model>

    <model name="elevator_2_door">
      <static>true</static>
      <pose>25 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.0 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.0 3.0</size></box></geometry>
          <material><ambient>0.6 0.7 0.8 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material>
