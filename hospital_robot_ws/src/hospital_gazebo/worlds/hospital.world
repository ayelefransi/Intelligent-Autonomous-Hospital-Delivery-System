    <!-- ==================== MEDICAL CARTS =================== -->
    <model name="medical_cart_1">
      <static>false</static>
      <pose>-5 1.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.9</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
        <inertial>
          <mass>20</mass>
          <inertia><ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.0</iyy><iyz>0</iyz><izz>0.5</izz></inertia>
        </inertial>
      </link>
    </model>

    <model name="medical_cart_2">
      <static>false</static>
      <pose>8 -1.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.9</size></box></geometry>
          <material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material>
        </visual>
        <inertial>
          <mass>20</mass>
          <inertia><ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.0</iyy><iyz>0</iyz><izz>0.5</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- ==================== ELEVATOR ZONES ================== -->
    <model name="elevator_1_door">
      <static>true</static>
      <pose>-25 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.0 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.0 3.0</size></box></geometry>
          <material><ambient>0.6 0.7 0.8 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material>
        </visual>
