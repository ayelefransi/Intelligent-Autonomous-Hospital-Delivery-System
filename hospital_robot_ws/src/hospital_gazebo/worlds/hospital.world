<?xml version="1.0"?>
<!--
  Hospital World SDF for Gazebo Harmonic
  ============================================================
  Layout:
    - Main corridor (40m x 3m, East-West)
    - North wing corridor (20m x 3m)
    - South wing corridor (20m x 3m)
    - ICU (4 beds, 10m x 8m)
    - Patient rooms x8 (4m x 5m each)
    - Pharmacy (5m x 6m)
    - Laboratory (5m x 6m)
    - 2x Operating rooms (6m x 7m each)
    - Nurse stations x3
    - Elevator zones x2
    - Emergency entrance

  Dynamic elements:
    - 3 doctors (walking, unpredictable)
    - 4 nurses (semi-predictable paths)
    - 2 patients on wheelchairs
    - 1 emergency stretcher

  Compatible: Gazebo Harmonic
  ============================================================
-->
<sdf version="1.9">
  <world name="hospital_world">

    <!-- ==================== PHYSICS ========================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ==================== PLUGINS ========================= -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ==================== SCENE =========================== -->
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.85 0.87 0.91 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- ==================== LIGHTING ======================== -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Corridor overhead lights -->
    <light type="point" name="corridor_light_1">
      <pose>-15 0 3.5 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>8</range>
        <linear>0.1</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light type="point" name="corridor_light_2">
      <pose>0 0 3.5 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>8</range>
        <linear>0.1</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light type="point" name="corridor_light_3">
      <pose>15 0 3.5 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>8</range>
        <linear>0.1</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- ==================== GROUND PLANE ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== HOSPITAL BUILDING ================ -->
    <!-- Outer walls - main building 50m x 30m -->

    <!-- North outer wall -->
    <model name="wall_north_outer">
      <static>true</static>
      <pose>0 15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>52 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>52 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South outer wall -->
    <model name="wall_south_outer">
      <static>true</static>
      <pose>0 -15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>52 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>52 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East outer wall -->
    <model name="wall_east_outer">
      <static>true</static>
      <pose>26 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 30 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 30 3.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West outer wall -->
    <model name="wall_west_outer">
      <static>true</static>
      <pose>-26 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 30 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 30 3.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== MAIN CORRIDOR WALLS ============== -->
    <!-- Main corridor runs E-W at y=0, width=3m -->

    <!-- North wall of main corridor (upper section) -->
    <model name="wall_corridor_north_w">
      <static>true</static>
      <pose>-15 1.65 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_corridor_north_e">
      <static>true</static>
      <pose>15 1.65 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall of main corridor -->
    <model name="wall_corridor_south_w">
      <static>true</static>
      <pose>-15 -1.65 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_corridor_south_e">
      <static>true</static>
      <pose>15 -1.65 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== PATIENT ROOMS (North) ============ -->
    <!-- 8 patient rooms, 4 on north side, 4 on south -->
    <!-- Each: 5m wide x 4m deep -->

    <!-- North rooms internal walls -->
    <model name="pr_n1_wall_e"><static>true</static><pose>-22 8.85 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 8.7 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.7 3.0</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>

    <model name="pr_n2_wall_e"><static>true</static><pose>-17 8.85 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 8.7 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.7 3.0</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>

    <model name="pr_n3_wall_e"><static>true</static><pose>-12 8.85 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 8.7 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.7 3.0</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>

    <model name="pr_n4_wall_e"><static>true</static><pose>-7 8.85 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 8.7 3.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.7 3.0</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>

    <!-- ==================== ICU AREA (East North) ============ -->
    <model name="icu_wall_south">
      <static>true</static>
      <pose>20 7.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 3.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="icu_wall_west">
      <static>true</static>
      <pose>14.1 11.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 3.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== PHARMACY (East) ================= -->
    <model name="pharmacy_wall_w">
      <static>true</static>
      <pose>14.1 -7.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
          <material><ambient>0.9 0.95 0.9 1</ambient><diffuse>0.9 0.95 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pharmacy_wall_n">
      <static>true</static>
      <pose>20 -2.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 3.0</size></box></geometry>
          <material><ambient>0.9 0.95 0.9 1</ambient><diffuse>0.9 0.95 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== OPERATING ROOMS ================= -->
    <model name="or1_wall_e">
      <static>true</static>
      <pose>-1.0 10.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 9.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 9.0 3.0</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="or1_wall_s">
      <static>true</static>
      <pose>-4.5 6.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0 0.2 3.0</size></box></geometry>
        </collision>
