<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hospital_robot_description</name>
  <version>1.0.0</version>
  <description>
    URDF and xacro description files for the Intelligent Autonomous Hospital
    Delivery Robot based on TurtleBot4 platform with hospital delivery
    extensions. Includes differential drive base, LiDAR, IMU, RGB-D camera,
    ultrasonic sensors, and payload delivery compartment.
  </description>
  <maintainer email="hospital_robot@example.com">Hospital Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
