<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Hospital TurtleBot4 Base Chassis
       Differential drive, TurtleBot4 dimensions
       Compatible: ROS 2 Jazzy + Gazebo Harmonic
       ============================================================ -->

  <xacro:property name="base_radius"       value="0.1775"/>
  <xacro:property name="base_height"       value="0.192"/>
  <xacro:property name="base_mass"         value="4.0"/>

  <xacro:property name="wheel_radius"      value="0.0352"/>
  <xacro:property name="wheel_width"       value="0.0182"/>
  <xacro:property name="wheel_mass"        value="0.1"/>
  <xacro:property name="wheel_separation"  value="0.233"/>

  <xacro:property name="caster_radius"     value="0.015"/>
  <xacro:property name="caster_mass"       value="0.05"/>

  <!-- ==================== INERTIA MACROS ======================= -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass*(3*radius*radius + length*length))/12}"
        ixy="0" ixz="0"
        iyy="${(mass*(3*radius*radius + length*length))/12}"
        iyz="0"
        izz="${(mass*radius*radius)/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2*mass*radius*radius)/5}"
        ixy="0" ixz="0"
        iyy="${(2*mass*radius*radius)/5}"
        iyz="0"
        izz="${(2*mass*radius*radius)/5}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass*(y*y + z*z))/12}"
        ixy="0" ixz="0"
        iyy="${(mass*(x*x + z*z))/12}"
        iyz="0"
        izz="${(mass*(x*x + y*y))/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== BASE FOOTPRINT ======================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK ============================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="${base_mass}" radius="${base_radius}" length="${base_height}"/>
  </link>

  <!-- ==================== WHEEL MACRO ========================== -->
  <xacro:macro name="wheel" params="name side y_offset">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <origin xyz="0 ${y_offset} ${-base_height/2 + wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left"  side="left"  y_offset=" ${wheel_separation/2}"/>
  <xacro:wheel name="right" side="right" y_offset="-${wheel_separation/2}"/>

  <!-- ==================== CASTER WHEELS ======================= -->
  <xacro:macro name="caster" params="name x_offset y_offset">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia mass="${caster_mass}" radius="${caster_radius}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_caster_link"/>
      <origin xyz="${x_offset} ${y_offset} ${-base_height/2 + caster_radius}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front_left"  x_offset=" 0.12" y_offset=" 0.10"/>
  <xacro:caster name="front_right" x_offset=" 0.12" y_offset="-0.10"/>
  <xacro:caster name="rear_left"   x_offset="-0.12" y_offset=" 0.10"/>
  <xacro:caster name="rear_right"  x_offset="-0.12" y_offset="-0.10"/>

  <!-- ==================== GAZEBO DIFF DRIVE =================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint state publisher for wheels -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
