<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       Hospital Delivery Payload Compartment
       Top-mounted secure delivery box with status LED
       ============================================================ -->

  <xacro:property name="box_width"   value="0.28"/>
  <xacro:property name="box_depth"   value="0.25"/>
  <xacro:property name="box_height"  value="0.20"/>
  <xacro:property name="box_mass"    value="0.8"/>
  <xacro:property name="box_z"       value="0.22"/>

  <xacro:property name="frame_width" value="0.31"/>
  <xacro:property name="frame_depth" value="0.28"/>
  <xacro:property name="frame_height" value="0.04"/>

  <!-- ==================== SUPPORT FRAME ======================= -->
  <link name="payload_frame_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${frame_depth} ${frame_width} ${frame_height}"/>
      </geometry>
      <material name="frame_color">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${frame_depth} ${frame_width} ${frame_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="payload_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="payload_frame_link"/>
    <origin xyz="0 0 ${0.096 + frame_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== DELIVERY BOX ======================== -->
  <link name="payload_box_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_depth} ${box_width} ${box_height}"/>
      </geometry>
      <material name="box_color">
        <color rgba="0.9 0.9 0.9 0.85"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${box_depth} ${box_width} ${box_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${box_mass}"/>
      <inertia
        ixx="${(box_mass*(box_width*box_width + box_height*box_height))/12}"
        ixy="0" ixz="0"
        iyy="${(box_mass*(box_depth*box_depth + box_height*box_height))/12}"
        iyz="0"
        izz="${(box_mass*(box_depth*box_depth + box_width*box_width))/12}"/>
    </inertial>
  </link>

  <joint name="payload_box_joint" type="fixed">
    <parent link="payload_frame_link"/>
    <child  link="payload_box_link"/>
    <origin xyz="0 0 ${frame_height/2 + box_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== STATUS LED STRIP ==================== -->
  <link name="led_strip_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.005 ${box_width} 0.01"/></geometry>
      <material name="led_idle"><color rgba="0.0 0.5 1.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.005 ${box_width} 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="led_front_joint" type="fixed">
    <parent link="payload_box_link"/>
    <child  link="led_strip_front_link"/>
    <origin xyz="${box_depth/2 + 0.003} 0 ${-box_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== PAYLOAD LATCH (decorative) ========== -->
  <link name="payload_latch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.01"/></geometry>
      <material name="latch_color"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="payload_latch_joint" type="fixed">
    <parent link="payload_box_link"/>
    <child  link="payload_latch_link"/>
    <origin xyz="${box_depth/2} 0 ${box_height/2}" rpy="${pi/2} 0 0"/>
  </joint>

</robot>
